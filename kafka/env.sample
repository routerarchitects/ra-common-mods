# Kafka Configuration Environment Variables
# ==========================================
# Copy this file to `.env` and update with your actual values.

# ==========================================
# Broker Configuration (BrokerConfig)
# ==========================================

# Comma-separated list of Kafka broker host:port addresses (required, no URL schemes)
# Example: "localhost:9092" or "broker1:9092,broker2:9092"
KAFKA_BROKERS=localhost:9092

# Client ID identifies this client in Kafka broker logs
# Default: "ra-kafka-client"
KAFKA_CLIENT_ID=my-service-client

# Network socket timeouts (per socket operation, not total request deadlines)
# Defaults: 30s each
KAFKA_DIAL_TIMEOUT=30s
KAFKA_READ_TIMEOUT=30s
KAFKA_WRITE_TIMEOUT=30s

# ==========================================
# SASL Authentication (KAFKA_AUTH_SASL_*)
# ==========================================

# Enable SASL authentication
# Default: false
KAFKA_AUTH_SASL_ENABLED=false

# SASL mechanism: PLAIN, SCRAM-SHA-256, or SCRAM-SHA-512
# Default: PLAIN
KAFKA_AUTH_SASL_MECHANISM=PLAIN

# SASL username and password (required when SASL is enabled)
# KAFKA_AUTH_SASL_USERNAME=your-username
# KAFKA_AUTH_SASL_PASSWORD=your-password

# Allow SASL PLAIN over unencrypted connections (development only - NOT for production)
# When SASL is PLAIN and TLS is disabled, this must be explicitly set to true.
# Default: false
KAFKA_AUTH_SASL_ALLOW_INSECURE_PLAINTEXT=false

# ==========================================
# TLS Configuration (KAFKA_AUTH_TLS_*)
# ==========================================

# Enable TLS encryption (minimum TLS 1.2)
# Default: false
KAFKA_AUTH_TLS_ENABLED=false

# Skip certificate verification (testing only - NOT for production)
# Default: false
KAFKA_AUTH_TLS_INSECURE_SKIP_VERIFY=false

# Paths to client certificate and private key (must specify both or neither)
# KAFKA_AUTH_TLS_CERT_FILE=/path/to/client.crt
# KAFKA_AUTH_TLS_KEY_FILE=/path/to/client.key

# Path to custom CA certificate PEM file (uses system roots if empty)
# KAFKA_AUTH_TLS_CA_FILE=/path/to/ca.crt

# ==========================================
# Consumer Group Configuration (KAFKA_CONSUMER_*)
# ==========================================

# Consumer group ID (required; keep stable across restarts to preserve offsets)
KAFKA_CONSUMER_GROUP_ID=my-consumer-group

# Initial offset fallback when no valid committed offset exists: "oldest" or "newest"
# Default: oldest
# v0.2.0 changed from "newest" to "oldest" to avoid skipping unprocessed records.
# Services migrating from v0.1.0 that want the previous skip-ahead behaviour must
# explicitly set this to "newest".
KAFKA_CONSUMER_INITIAL_OFFSET=oldest

# Partition assignment strategy: "roundrobin", "sticky", or "range"
# Default: roundrobin
KAFKA_CONSUMER_BALANCE_STRATEGY=roundrobin

# Consumer group session, heartbeat, and rebalance timeouts
# Defaults: 10s / 3s / 60s (heartbeat must be < session timeout)
KAFKA_CONSUMER_SESSION_TIMEOUT=10s
KAFKA_CONSUMER_HEARTBEAT_INTERVAL=3s
KAFKA_CONSUMER_REBALANCE_TIMEOUT=60s

# Sarama internal message-channel delivery backpressure timeout (NOT handler timeout).
# A slow partition with a full buffer can delay the shared broker fetch loop.
# Default: 100ms
KAFKA_CONSUMER_MAX_PROCESSING_TIME=100ms

# Offset commit mode: "periodic" or "sync"
# Default: periodic
KAFKA_CONSUMER_COMMIT_MODE=periodic

# Periodic auto-commit interval (must be > 0 when commit mode is "periodic")
# Default: 5s
KAFKA_CONSUMER_COMMIT_INTERVAL=5s

# Cooperative per-attempt handler timeout
# Default: 30s
KAFKA_CONSUMER_HANDLER_TIMEOUT=30s

# Graceful drain budget for admitted in-flight messages on shutdown
# Default: 30s
KAFKA_CONSUMER_SHUTDOWN_TIMEOUT=30s

# How long to wait after the drain completes or expires before aborting pending
# consumer broker I/O, including offset commits and group leave.
# Default: 5s
KAFKA_CONSUMER_CLOSE_TIMEOUT=5s

# Automatically reset out-of-range committed offsets to INITIAL_OFFSET (true)
# or stop consumption with a terminal error (false) when an invalid offset is
# encountered. Set to false when data gaps require operator intervention.
# Default: true
KAFKA_CONSUMER_RESET_INVALID_OFFSETS=true

# Consumer transactional read isolation:
# "read_uncommitted" - reads all records including aborted transactional ones (default)
# "read_committed"   - hides aborted transactional records
# Default: read_uncommitted
KAFKA_CONSUMER_ISOLATION_LEVEL=read_uncommitted

# ==========================================
# Producer Configuration (KAFKA_PRODUCER_*)
# ==========================================

# Maximum message size in bytes (> 0)
# Default: 1000000
KAFKA_PRODUCER_MAX_MESSAGE_BYTES=1000000

# Required acknowledgements: 0 (none), 1 (leader), -1 (all ISR; required for idempotence)
# Default: -1
KAFKA_PRODUCER_REQUIRED_ACKS=-1

# Produce request timeout (> 0)
# Default: 10s
KAFKA_PRODUCER_TIMEOUT=10s

# Compression codec: none, gzip, snappy, lz4, or zstd
# Default: snappy
KAFKA_PRODUCER_COMPRESSION=snappy

# Key-to-partition routing: "hash" (Sarama FNV-1a), "crc32" (librdkafka consistent_random),
# "murmur2" (Java Kafka client), "roundrobin", or "random".
# Default: hash
KAFKA_PRODUCER_PARTITIONER=hash

# Enable idempotent producer (requires required_acks=-1 and max_retries>=1;
# deduplicates retries within a single producer session, not across restarts)
# Default: true
KAFKA_PRODUCER_IDEMPOTENT=true

# Maximum number of retries for failed produce requests (>= 0; >= 1 if idempotent)
# Default: 3
KAFKA_PRODUCER_MAX_RETRIES=3

# Backoff duration between produce retries (>= 0)
# Default: 100ms
KAFKA_PRODUCER_RETRY_BACKOFF=100ms
